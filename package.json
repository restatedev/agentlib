{
  "name": "restate-agents-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "build": "turbo run compile lint format typecheck",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --type-aware --type-check --deny-warnings .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "check": "pnpm build && pnpm test && pnpm test:integration",
    "dev": "turbo run compile --filter=@restate-agents/examples^... && pnpm --filter @restate-agents/examples dev",
    "start": "pnpm --filter @restate-agents/examples start"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "^4.23.13",
    "turbo": "2.10.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.9.0"
}
