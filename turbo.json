{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "compile": {
      "dependsOn": ["^compile"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^compile"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^compile"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^compile"],
      "cache": false,
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*"]
    },
    "//#lint": {
      "dependsOn": ["@restatedev/agentlib#compile", "@restatedev/agentlib-examples#compile"],
      "cache": false
    },
    "//#format": {
      "cache": false
    },
    "//#lint:fix": {
      "cache": false
    },
    "//#format:fix": {
      "cache": false
    }
  }
}
