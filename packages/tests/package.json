{
  "name": "@restate-agents/tests",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test --test-timeout=60000 'src/*.test.ts'",
    "test:integration": "node --experimental-test-module-mocks --import tsx --test --test-timeout=180000 'src/*.integration.ts' && node --experimental-test-module-mocks --test --test-timeout=180000 src/ag-ui.integration.mts"
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.0",
    "@langchain/core": "1.2.13",
    "@langchain/openai": "1.6.0",
    "@restate-agents/core": "workspace:*",
    "@restate-agents/examples": "workspace:*",
    "@restatedev/restate-sdk": "^1.17.2",
    "@restatedev/restate-sdk-clients": "1.17.2",
    "@restatedev/restate-sdk-gen": "1.17.2",
    "@restatedev/restate-sdk-testcontainers": "1.17.2",
    "ai": "7.0.26",
    "minisearch": "7.2.0",
    "modal": "0.10.1",
    "openai": "^7.17.0",
    "zod": "^4.6.5"
  }
}
