{
  "name": "@restatedev/agentlib",
  "version": "0.1.0",
  "description": "Embeddable AI agents native to Restate coroutines",
  "keywords": [
    "agents",
    "ai",
    "durable-execution",
    "restate",
    "workflow"
  ],
  "homepage": "https://github.com/restatedev/agentlib#readme",
  "bugs": {
    "url": "https://github.com/restatedev/agentlib/issues"
  },
  "license": "MIT",
  "author": "Restate Developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/restatedev/agentlib.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "import": "./dist/openai.js"
    },
    "./program": {
      "types": "./dist/program.d.ts",
      "import": "./dist/program.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "import": "./dist/discovery.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "compile": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@modelcontextprotocol/client": "2.3.0",
    "@opentelemetry/api": "1.9.0",
    "ai": "7.0.26",
    "minisearch": "7.2.0",
    "openai": "^7.17.0",
    "quickjs-emscripten-core": "0.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@restatedev/restate-sdk": "^1.18.2",
    "@restatedev/restate-sdk-gen": "^1.18.2"
  },
  "peerDependencies": {
    "@restatedev/restate-sdk": "^1.18.2",
    "@restatedev/restate-sdk-gen": "^1.18.2"
  },
  "email": "code@restate.dev"
}
