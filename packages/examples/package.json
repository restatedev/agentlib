{
  "name": "@restate-agents/examples",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./session": {
      "types": "./dist/ai-session.d.ts",
      "import": "./dist/ai-session.js"
    },
    "./research-report": {
      "types": "./dist/research-report.d.ts",
      "import": "./dist/research-report.js"
    },
    "./evaluator-optimizer": {
      "types": "./dist/evaluator-optimizer.d.ts",
      "import": "./dist/evaluator-optimizer.js"
    },
    "./racing-agents": {
      "types": "./dist/racing-agents.d.ts",
      "import": "./dist/racing-agents.js"
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/app.ts",
    "start": "node dist/app.js"
  },
  "dependencies": {
    "@restate-agents/core": "workspace:*",
    "@restatedev/restate-sdk": "^1.17.1",
    "@restatedev/restate-sdk-gen": "^1.17.1",
    "zod": "^4.6.5"
  }
}
