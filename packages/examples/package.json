{
  "name": "@restate-agents/examples",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./coroutine/session": {
      "types": "./dist/coroutine/ai-session.d.ts",
      "import": "./dist/coroutine/ai-session.js"
    },
    "./coroutine/research-report": {
      "types": "./dist/coroutine/research-report.d.ts",
      "import": "./dist/coroutine/research-report.js"
    },
    "./coroutine/evaluator-optimizer": {
      "types": "./dist/coroutine/evaluator-optimizer.d.ts",
      "import": "./dist/coroutine/evaluator-optimizer.js"
    },
    "./coroutine/racing-agents": {
      "types": "./dist/coroutine/racing-agents.d.ts",
      "import": "./dist/coroutine/racing-agents.js"
    },
    "./promise/regular-sdk": {
      "types": "./dist/promise/regular-sdk.d.ts",
      "import": "./dist/promise/regular-sdk.js"
    },
    "./promise/evaluator-optimizer": {
      "types": "./dist/promise/evaluator-optimizer.d.ts",
      "import": "./dist/promise/evaluator-optimizer.js"
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/app.ts",
    "start": "node dist/app.js",
    "dev:coroutine": "tsx watch src/coroutine/app.ts",
    "dev:promise": "tsx watch src/promise/app.ts"
  },
  "dependencies": {
    "@restate-agents/core": "workspace:*",
    "@restate-agents/promise": "workspace:*",
    "@restatedev/restate-sdk": "^1.17.1",
    "@restatedev/restate-sdk-gen": "1.17.1",
    "zod": "^4.6.5"
  }
}
